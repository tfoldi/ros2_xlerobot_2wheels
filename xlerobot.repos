# Community packages this stack depends on, pulled with vcs import.
# Not vendored in src/ directly since these are third-party and change on
# their own schedule. See ARCHITECTURE §3 for why each one is here.
#
#   vcs import --recursive src < xlerobot.repos
#
# --recursive is needed for ldrobot_lidar_ros2, its LDROBOT SDK is a git submodule.
#
repositories:
  sts_hardware_interface:
    type: git
    url: https://github.com/tfoldi/sts_hardware_interface.git
    version: main
    # ros2_control interface for the Feetech bus. The critical dependency,
    # see ADR-0001. Canonical source is the tfoldi fork's main, which carries
    # fixes this stack needs (multi-turn wheel position unwrap, per-instance
    # service names, SyncRead buffer init). Each one is also sent upstream to
    # adityakamath/sts_hardware_interface as its own PR; fork main is kept
    # merged with upstream main.

  so_arm_ros2:
    type: git
    url: https://github.com/adityakamath/so_arm_ros2.git
    version: main
    # phase 3, reference only for now, joint limits and MoveIt config get
    # pulled into our own xacro rather than depending on this directly,
    # see ARCHITECTURE §3. Not needed until arms start.

  topic_based_hardware_interfaces:
    type: git
    url: https://github.com/ros-controls/topic_based_hardware_interfaces.git
    version: main
    # official ros-controls package, Jazzy supported. joint_state_topic_hardware_interface
    # is the real hardware_interface plugin behind the Isaac Sim twin (use_sim:=true),
    # nothing to do with the physical robot. Has a documented sum_wrapped_joint_states
    # option specifically because "Isaac Sim only reports joint states from 2*pi to -2*pi",
    # i.e. it wraps too, just differently from the real STS3215 encoder. See ARCHITECTURE
    # §4.1 and docs/sim-twin.md.

  ldrobot_lidar_ros2:
    type: git
    url: https://github.com/Myzhar/ldrobot-lidar-ros2.git
    version: 4ee53a8b176037cf418a54b25007075bb2b1d3a0
    # LDROBOT LD19 2D lidar driver, a lifecycle node publishing /ldlidar_node/scan.
    # Builds on Jazzy as is. LDROBOT's own driver (ldrobotSensorTeam/ldlidar_stl_ros2) does
    # not build on Jazzy, it lacks an include GCC 13 needs. Apache-2.0.
