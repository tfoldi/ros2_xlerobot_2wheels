<?xml version="1.0"?>
<!--
  Neck and head pan/tilt, IDs 7 and 8 on bus1.

  Converted from simulation/xlerobot/xlerobot.urdf of the XLeRobot repo
  (xlerobot_urdf.zip): the printed top base, neck and head meshes
  (meshes/upstream), link frames, joint origins and axes. The pan axis position
  in base_link comes from robot_dimensions.yaml (head: mount_x/y/z), the top base
  and everything above it follows from that. The head tilt link is turned 180
  degrees about z, as in upstream, so its x axis points backwards; the camera
  mount frame accounts for that. Pan/tilt limits are upstream's, TODO check them
  against the mechanical stops.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="xlerobot_head" params="dims parent">
    <xacro:property name="h" value="${dims['head']}"/>

    <!-- The top base sits on the arm mounting surface, 0.045 m below it as in the
         upstream URDF, and 0.103 m ahead of the pan axis. head: mount_z is the
         measured height of the junction where the pan servo's axis meets the head's
         printed part, that is 0.073 m above the pan joint origin in the upstream
         head meshes, so the origin is at mount_z - 0.073. That gives 0.325 m above
         the top base, upstream has 0.323. If the neck were longer than upstream's,
         neck_ext is the difference and a plain rod fills it. -->
    <xacro:property name="top_base_z" value="${dims['arms']['mount_z'] - 0.045}"/>
    <xacro:property name="pan_z" value="${h['mount_z'] - 0.073}"/>
    <xacro:property name="pan_dz" value="${pan_z - top_base_z}"/>
    <xacro:property name="neck_ext" value="${pan_dz - 0.323}"/>
    <joint name="top_base_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="top_base_link"/>
      <origin xyz="${h['mount_x'] + 0.103} ${h['mount_y']} ${top_base_z}" rpy="0 0 0"/>
    </joint>

    <link name="top_base_link">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.2542"/>
        <inertia ixx="0.0045" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.0045"/>
      </inertial>
      <visual>
        <origin xyz="-0.44 -0.005 -0.6" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://xlerobot_description/meshes/upstream/topbase1.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="xle_part"/>
      </visual>
      <visual>
        <origin xyz="-0.298 0.006 -0.715" rpy="0 0 3.14"/>
        <geometry>
          <mesh filename="package://xlerobot_description/meshes/upstream/topbase2.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="xle_motor"/>
      </visual>
      <xacro:if value="${neck_ext > 0.01}">
        <visual>
          <origin xyz="-0.103 0 ${0.323 + neck_ext / 2.0}" rpy="0 0 0"/>
          <geometry><cylinder radius="0.03" length="${neck_ext}"/></geometry>
          <material name="xle_motor"/>
        </visual>
      </xacro:if>
    </link>

    <link name="head_pan_link">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.2556"/>
        <inertia ixx="0.0129" ixy="0" ixz="0" iyy="0.0095" iyz="0" izz="0.0184"/>
      </inertial>
      <visual>
        <origin xyz="-0.335 -0.005 -0.923" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://xlerobot_description/meshes/upstream/tophead1.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="xle_part"/>
      </visual>
      <visual>
        <origin xyz="1.17 -0.009 0.262" rpy="-3.141592 -1.57 -3.141592"/>
        <geometry>
          <mesh filename="package://xlerobot_description/meshes/upstream/tophead4.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="xle_motor"/>
      </visual>
    </link>

    <joint name="head_pan_joint" type="revolute">
      <parent link="top_base_link"/>
      <child link="head_pan_link"/>
      <origin xyz="-0.103 0 ${pan_dz}" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="${h['pan_limit_lower']}" upper="${h['pan_limit_upper']}" effort="2.0" velocity="3.0"/>
    </joint>

    <link name="head_tilt_link">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.02087"/>
        <inertia ixx="0.0061" ixy="0" ixz="0" iyy="0.0014" iyz="0" izz="0.0061"/>
      </inertial>
      <visual>
        <origin xyz="0.16265 -0.006 -1.16815" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://xlerobot_description/meshes/upstream/tophead5.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="xle_part"/>
      </visual>
      <visual>
        <origin xyz="0.16265 -0.006 -1.16815" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://xlerobot_description/meshes/upstream/tophead6.stl" scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="xle_motor"/>
      </visual>
    </link>

    <joint name="head_tilt_joint" type="revolute">
      <parent link="head_pan_link"/>
      <child link="head_tilt_link"/>
      <origin xyz="0.001 0.002 0.09815" rpy="0 0 3.1415927"/>
      <axis xyz="0 1 0"/>
      <limit lower="${h['tilt_limit_lower']}" upper="${h['tilt_limit_upper']}" effort="2.0" velocity="3.0"/>
    </joint>

    <!-- sensor gets attached here, in sensors.xacro -->
    <link name="head_camera_mount"/>
    <joint name="head_camera_mount_joint" type="fixed">
      <parent link="head_tilt_link"/>
      <child link="head_camera_mount"/>
      <!-- z puts the lens centre at head: camera_z above the floor -->
      <origin xyz="${h['camera_x']} 0 ${h['camera_z'] - pan_z - 0.09815}" rpy="0 0 0"/>
    </joint>
  </xacro:macro>
</robot>
