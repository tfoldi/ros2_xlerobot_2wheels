<?xml version="1.0"?>
<!--
  One arm, names prefixed (left_arm_shoulder_pan_joint, left_arm_wrist_camera_optical_frame, ...).

  Converted from the arm in simulation/xlerobot/xlerobot.urdf of the XLeRobot
  repo (xlerobot_urdf.zip): same meshes (meshes/upstream), link frames, joint
  origins, axes, limits and inertials. The zero pose is that URDF's, the arm
  stretched straight out to the side, and it folds by about +3 rad at the shoulder
  lift and elbow, which is how the real arms rest. Only the joint velocity limit
  changed, the source has 0, 3 rad/s here so planners get a usable limit. Joint axes and
  limits follow arms.joints in robot_dimensions.yaml: where the real servo goes the other
  way from the source's angle the axis is reversed and the limits mirrored.

  Frame names follow the ros2_control joints and the sim, not upstream's
  (upstream calls the arm on the right side *_L). The wrist camera is upstream's
  Right/Left_Arm_Camera, its optical frame is REP-103 (z forward, the camera looks
  along the fixed jaw).

  parent/xyz/rpy place the arm's base_link. upstream mounts the arm on the right
  side (y<0) with rpy 0 and the one on the left (y>0) turned 180 degrees about z.
  wrist_camera:=false leaves out the camera links.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="so101_arm" params="prefix parent xyz rpy joints wrist_camera:=true">

    <!-- joint direction, see arms.joints in robot_dimensions.yaml: m is -1 to reverse the
         axis (and mirror the limits) where the servo step goes the same way as the joint
         angle. Reversing axis and angle together is the same pose. -->
    <xacro:property name="m_pan" value="${-joints['shoulder_pan']['direction']}"/>
    <xacro:property name="lo_pan" value="${min(m_pan * joints['shoulder_pan']['lower'], m_pan * joints['shoulder_pan']['upper'])}"/>
    <xacro:property name="hi_pan" value="${max(m_pan * joints['shoulder_pan']['lower'], m_pan * joints['shoulder_pan']['upper'])}"/>
    <xacro:property name="m_lift" value="${-joints['shoulder_lift']['direction']}"/>
    <xacro:property name="lo_lift" value="${min(m_lift * joints['shoulder_lift']['lower'], m_lift * joints['shoulder_lift']['upper'])}"/>
    <xacro:property name="hi_lift" value="${max(m_lift * joints['shoulder_lift']['lower'], m_lift * joints['shoulder_lift']['upper'])}"/>
    <xacro:property name="m_elbow" value="${-joints['elbow_flex']['direction']}"/>
    <xacro:property name="lo_elbow" value="${min(m_elbow * joints['elbow_flex']['lower'], m_elbow * joints['elbow_flex']['upper'])}"/>
    <xacro:property name="hi_elbow" value="${max(m_elbow * joints['elbow_flex']['lower'], m_elbow * joints['elbow_flex']['upper'])}"/>
    <xacro:property name="m_wflex" value="${-joints['wrist_flex']['direction']}"/>
    <xacro:property name="lo_wflex" value="${min(m_wflex * joints['wrist_flex']['lower'], m_wflex * joints['wrist_flex']['upper'])}"/>
    <xacro:property name="hi_wflex" value="${max(m_wflex * joints['wrist_flex']['lower'], m_wflex * joints['wrist_flex']['upper'])}"/>
    <xacro:property name="m_roll" value="${-joints['wrist_roll']['direction']}"/>
    <xacro:property name="lo_roll" value="${min(m_roll * joints['wrist_roll']['lower'], m_roll * joints['wrist_roll']['upper'])}"/>
    <xacro:property name="hi_roll" value="${max(m_roll * joints['wrist_roll']['lower'], m_roll * joints['wrist_roll']['upper'])}"/>
    <xacro:property name="m_grip" value="${-joints['gripper']['direction']}"/>
    <xacro:property name="lo_grip" value="${min(m_grip * joints['gripper']['lower'], m_grip * joints['gripper']['upper'])}"/>
    <xacro:property name="hi_grip" value="${max(m_grip * joints['gripper']['lower'], m_grip * joints['gripper']['upper'])}"/>

    <joint name="${prefix}_mount_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${prefix}_base_link"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>

    <link name="${prefix}_base_link">
      <inertial>
        <origin xyz="0.0137179 -0.000052 0.0334843" rpy="0 0 0"/>
        <mass value="0.147"/>
        <inertia ixx="0.0001147" ixy="-0.0000005" ixz="0.000005" iyy="0.0001361" iyz="0.0000001" izz="0.0001304"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://xlerobot_description/meshes/upstream/Base.stl"/>
        </geometry>
        <material name="xle_part"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://xlerobot_description/meshes/upstream/Base.stl"/>
        </geometry>
      </collision>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://xlerobot_description/meshes/upstream/Base_Motor.stl"/>
        </geometry>
        <material name="xle_motor"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://xlerobot_description/meshes/upstream/Base_Motor.stl"/>
        </geometry>
      </collision>
    </link>
    <link name="${prefix}_shoulder_link">
      <inertial>
        <origin xyz="-0.0307604 -0.0000167 -0.0252713" rpy="0 0 0"/>
        <mass value="0.100006"/>
        <inertia ixx="0.0000838" ixy="0.0000001" ixz="-0.0000012" iyy="0.000081" iyz="0.0000002" izz="0.000024"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://xlerobot_description/meshes/upstream/Rotation_Pitch.stl"/>
        </geometry>
        <material name="xle_part"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://xlerobot_description/meshes/upstream/Rotation_Pitch.stl"/>
        </geometry>
      </collision>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://xlerobot_description/meshes/upstream/Rotation_Pitch_Motor.stl"/>
        </geometry>
        <material name="xle_motor"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://xlerobot_description/meshes/upstream/Rotation_Pitch_Motor.stl"/>
        </geometry>
      </collision>
    </link>
    <link name="${prefix}_upper_arm_link">
      <inertial>
        <origin xyz="-0.0898471 -0.0083822 0.0184089" rpy="0 0 0"/>
        <mass value="0.103"/>
        <inertia ixx="0.0000408" ixy="-0.0000198" ixz="0" iyy="0.0001473" iyz="0" izz="0.0001425"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://xlerobot_description/meshes/upstream/Upper_Arm.stl"/>
        </geometry>
        <material name="xle_part"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://xlerobot_description/meshes/upstream/Upper_Arm.stl"/>
        </geometry>
      </collision>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://xlerobot_description/meshes/upstream/Upper_Arm_Motor.stl"/>
        </geometry>
        <material name="xle_motor"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://xlerobot_description/meshes/upstream/Upper_Arm_Motor.stl"/>
        </geometry>
      </collision>
    </link>
    <link name="${prefix}_lower_arm_link">
      <inertial>
        <origin xyz="-0.0980701 0.0032438 0.0182831" rpy="0 0 0"/>
        <mass value="0.104"/>
        <inertia ixx="0.0000287" ixy="0.0000074" ixz="0.0000013" iyy="0.0001598" iyz="0" izz="0.0001453"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://xlerobot_description/meshes/upstream/Lower_Arm.stl"/>
        </geometry>
        <material name="xle_part"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://xlerobot_description/meshes/upstream/Lower_Arm.stl"/>
        </geometry>
      </collision>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://xlerobot_description/meshes/upstream/Lower_Arm_Motor.stl"/>
        </geometry>
        <material name="xle_motor"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://xlerobot_description/meshes/upstream/Lower_Arm_Motor.stl"/>
        </geometry>
      </collision>
    </link>
    <link name="${prefix}_wrist_link">
      <inertial>
        <origin xyz="-0.0001033 -0.0386143 0.0281156" rpy="0 0 0"/>
        <mass value="0.079"/>
        <inertia ixx="0.0000368" ixy="0" ixz="-0.0000001" iyy="0.0000254" iyz="0.0000036" izz="0.000021"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://xlerobot_description/meshes/upstream/Wrist_Pitch_Roll.stl"/>
        </geometry>
        <material name="xle_part"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://xlerobot_description/meshes/upstream/Wrist_Pitch_Roll.stl"/>
        </geometry>
      </collision>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://xlerobot_description/meshes/upstream/Wrist_Pitch_Roll_Motor.stl"/>
        </geometry>
        <material name="xle_motor"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://xlerobot_description/meshes/upstream/Wrist_Pitch_Roll_Motor.stl"/>
        </geometry>
      </collision>
    </link>
    <link name="${prefix}_gripper_link">
      <inertial>
        <origin xyz="0.0002136 0.0002451 -0.025187" rpy="0 0 0"/>
        <mass value="0.087"/>
        <inertia ixx="0.0000275" ixy="-0.0000003" ixz="-0.0000057" iyy="0.0000434" iyz="-0.0000001" izz="0.0000345"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://xlerobot_description/meshes/upstream/Fixed_Jaw.stl"/>
        </geometry>
        <material name="xle_part"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://xlerobot_description/meshes/upstream/Fixed_Jaw_part1.ply.convex.stl"/>
        </geometry>
      </collision>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://xlerobot_description/meshes/upstream/Fixed_Jaw_part2.ply.convex.stl"/>
        </geometry>
      </collision>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://xlerobot_description/meshes/upstream/Fixed_Jaw_Motor.stl"/>
        </geometry>
        <material name="xle_motor"/>
      </visual>
    </link>
    <link name="${prefix}_moving_jaw_link">
      <inertial>
        <origin xyz="-0.001575 -0.0300244 0.0192755" rpy="0 0 0"/>
        <mass value="0.012"/>
        <inertia ixx="0.0000066" ixy="-0.0000003" ixz="0" iyy="0.0000019" iyz="-0.0000001" izz="0.0000053"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://xlerobot_description/meshes/upstream/Moving_Jaw.stl"/>
        </geometry>
        <material name="xle_part"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://xlerobot_description/meshes/upstream/Moving_Jaw_part1.ply.convex.stl"/>
        </geometry>
      </collision>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://xlerobot_description/meshes/upstream/Moving_Jaw_part2.ply.convex.stl"/>
        </geometry>
      </collision>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://xlerobot_description/meshes/upstream/Moving_Jaw_part3.ply.convex.stl"/>
        </geometry>
      </collision>
    </link>

    <joint name="${prefix}_shoulder_pan_joint" type="revolute">
      <parent link="${prefix}_base_link"/>
      <child link="${prefix}_shoulder_link"/>
      <origin xyz="0 -0.0452 0.0165" rpy="1.5708 0 0"/>
      <axis xyz="0 ${-1 * m_pan} 0"/>
      <limit lower="${lo_pan}" upper="${hi_pan}" effort="3.35" velocity="3.0"/>
      <dynamics damping="0.6" friction="0.052"/>
    </joint>
    <joint name="${prefix}_shoulder_lift_joint" type="revolute">
      <parent link="${prefix}_shoulder_link"/>
      <child link="${prefix}_upper_arm_link"/>
      <origin xyz="0 0.1025 0.0306" rpy="1.5708 0 0"/>
      <axis xyz="${-1 * m_lift} 0 0"/>
      <limit lower="${lo_lift}" upper="${hi_lift}" effort="3.35" velocity="3.0"/>
      <dynamics damping="0.6" friction="0.052"/>
    </joint>
    <joint name="${prefix}_elbow_flex_joint" type="revolute">
      <parent link="${prefix}_upper_arm_link"/>
      <child link="${prefix}_lower_arm_link"/>
      <origin xyz="0 0.11257 0.028" rpy="-1.5708 0 0"/>
      <axis xyz="${m_elbow} 0 0"/>
      <limit lower="${lo_elbow}" upper="${hi_elbow}" effort="3.35" velocity="3.0"/>
      <dynamics damping="0.6" friction="0.052"/>
    </joint>
    <joint name="${prefix}_wrist_flex_joint" type="revolute">
      <parent link="${prefix}_lower_arm_link"/>
      <child link="${prefix}_wrist_link"/>
      <origin xyz="0 0.0052 0.1349" rpy="-1.5708 0 0"/>
      <axis xyz="${m_wflex} 0 0"/>
      <limit lower="${lo_wflex}" upper="${hi_wflex}" effort="3.35" velocity="3.0"/>
      <dynamics damping="0.6" friction="0.052"/>
    </joint>
    <joint name="${prefix}_wrist_roll_joint" type="revolute">
      <parent link="${prefix}_wrist_link"/>
      <child link="${prefix}_gripper_link"/>
      <origin xyz="0 -0.0601 0" rpy="0 1.5707927 0"/>
      <axis xyz="0 ${-1 * m_roll} 0"/>
      <limit lower="${lo_roll}" upper="${hi_roll}" effort="3.35" velocity="3.0"/>
      <dynamics damping="0.6" friction="0.052"/>
    </joint>
    <joint name="${prefix}_gripper_joint" type="revolute">
      <parent link="${prefix}_gripper_link"/>
      <child link="${prefix}_moving_jaw_link"/>
      <origin xyz="-0.0202 -0.0244 0" rpy="3.1415854 -0.0000014 2.9531853"/>
      <axis xyz="0 0 ${m_grip}"/>
      <limit lower="${lo_grip}" upper="${hi_grip}" effort="10" velocity="3.0"/>
      <dynamics damping="0.6" friction="0.052"/>
    </joint>

    <xacro:if value="${wrist_camera}">
      <link name="${prefix}_wrist_camera_link">
        <visual>
          <origin xyz="-0.015 -0.026 0" rpy="0 0 0"/>
          <geometry>
            <mesh filename="package://xlerobot_description/meshes/upstream/XLeRobot_camera1.stl" scale="0.001 0.001 0.001"/>
          </geometry>
          <material name="xle_part"/>
        </visual>
        <visual>
          <origin xyz="-0.015 -0.026 0" rpy="0 0 0"/>
          <geometry>
            <mesh filename="package://xlerobot_description/meshes/upstream/XLeRobot_camera2.stl" scale="0.001 0.001 0.001"/>
          </geometry>
          <material name="xle_motor"/>
        </visual>
      </link>
      <joint name="${prefix}_wrist_camera_joint" type="fixed">
        <parent link="${prefix}_gripper_link"/>
        <child link="${prefix}_wrist_camera_link"/>
        <origin xyz="0 -0.022 0.05" rpy="1.5707963 0.0000037 -1.5708"/>
      </joint>
      <!-- REP-103 optical frame, z forward: the camera link's x axis looks along the jaw -->
      <link name="${prefix}_wrist_camera_optical_frame"/>
      <joint name="${prefix}_wrist_camera_optical_joint" type="fixed">
        <parent link="${prefix}_wrist_camera_link"/>
        <child link="${prefix}_wrist_camera_optical_frame"/>
        <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
      </joint>
    </xacro:if>
  </xacro:macro>
</robot>
