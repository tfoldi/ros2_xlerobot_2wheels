<?xml version="1.0"?>
<!--
  One hardware interface per serial bus. The split crosses subsystems:

    bus1: left arm 1-6 (position) + head 7-8 (position)
    bus2: right arm 1-6 (position) + wheels 9-10 (velocity)

  So bus2 runs mixed modes on one UART. sts_hardware_interface does this with a
  per-joint operating_mode param, which is why we picked it.

  Two instances of this plugin under one controller_manager work: both
  buses load, configure, and activate cleanly (adityakamath/sts_hardware_interface).
  One gotcha: each instance opens its own internal node hardcoded to the
  name "sts_hardware_interface_node" (src/sts_hardware_interface.cpp:622),
  and both advertise /emergency_stop on that same absolute name. Two
  servers, one service name, so calling /emergency_stop only reaches one
  bus, not both. Don't build the safety supervisor around that service,
  see ARCHITECTURE.md section 4.4.

  Multi-turn wheel position does not unwrap. The driver reads the raw
  encoder register every cycle and maps it straight to radians
  (sts_conversions.hpp: raw_position_to_radians), no revolution counter,
  same code path for every operating_mode. A continuously spinning wheel
  wraps every physical turn (~0.4m here), diff_drive_controller differences
  that position, so odometry breaks on the first wrap. Needs either an
  upstream patch or a local unwrapping layer before this can feed
  diff_drive_controller, see ARCHITECTURE.md section 4.1.

  Plugin uses its OWN mock mode (enable_mock_mode) rather than
  mock_components/GenericSystem, so use_mock_hardware:=true still exercises
  the real per-joint param parsing and mode assignment.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="sts_position_joint" params="name id lower upper">
    <joint name="${name}">
      <param name="motor_id">${id}</param>
      <param name="operating_mode">0</param>
      <command_interface name="position">
        <param name="min">${lower}</param>
        <param name="max">${upper}</param>
      </command_interface>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
      <!-- safety supervisor uses these -->
      <state_interface name="temperature"/>
      <state_interface name="current"/>
      <state_interface name="voltage"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="xlerobot_ros2_control" params="bus1_port bus2_port use_mock_hardware with_arms with_head dims">

    <xacro:property name="b"      value="${dims['base']}"/>
    <xacro:property name="h"      value="${dims['head']}"/>
    <xacro:property name="wmax"   value="${dims['limits']['wheel_max_angular_velocity']}"/>

    <!-- ================= BUS 1 : left arm + head ================= -->
    <!-- Only declared when something is actually on it. Otherwise this
         component still tries to open bus1_port for zero joints, and on a
         base-only robot that port doesn't exist - controller_manager loads
         all hardware components in one process, so a bad bus1_port there
         takes bus2 (the wheels) down with it too. -->
    <xacro:if value="${with_arms or with_head}">
      <ros2_control name="xlerobot_bus1" type="system">
        <hardware>
          <plugin>sts_hardware_interface/STSHardwareInterface</plugin>
          <param name="serial_port">${bus1_port}</param>
          <param name="baud_rate">1000000</param>
          <param name="enable_mock_mode">$(arg use_mock_hardware)</param>
        </hardware>

        <xacro:if value="${with_arms}">
          <!-- phase 3. Limits are placeholders, check against
               adityakamath/so_arm_ros2 and ros-physical-ai/ros2_so_arm -->
          <xacro:sts_position_joint name="left_arm_shoulder_pan"   id="1" lower="-3.14" upper="3.14"/>
          <xacro:sts_position_joint name="left_arm_shoulder_lift"  id="2" lower="-1.75" upper="1.75"/>
          <xacro:sts_position_joint name="left_arm_elbow_flex"     id="3" lower="-1.75" upper="1.75"/>
          <xacro:sts_position_joint name="left_arm_wrist_flex"     id="4" lower="-1.75" upper="1.75"/>
          <xacro:sts_position_joint name="left_arm_wrist_roll"     id="5" lower="-3.14" upper="3.14"/>
          <xacro:sts_position_joint name="left_arm_gripper"        id="6" lower="0.0"   upper="1.75"/>
        </xacro:if>

        <xacro:if value="${with_head}">
          <xacro:sts_position_joint name="head_pan_joint"  id="7"
                                    lower="${h['pan_limit_lower']}"  upper="${h['pan_limit_upper']}"/>
          <xacro:sts_position_joint name="head_tilt_joint" id="8"
                                    lower="${h['tilt_limit_lower']}" upper="${h['tilt_limit_upper']}"/>
        </xacro:if>
      </ros2_control>
    </xacro:if>

    <!-- ================= BUS 2 : right arm + DRIVE WHEELS ================= -->
    <ros2_control name="xlerobot_bus2" type="system">
      <hardware>
        <plugin>sts_hardware_interface/STSHardwareInterface</plugin>
        <param name="serial_port">${bus2_port}</param>
        <param name="baud_rate">1000000</param>
        <param name="enable_mock_mode">$(arg use_mock_hardware)</param>
      </hardware>

      <xacro:if value="${with_arms}">
        <xacro:sts_position_joint name="right_arm_shoulder_pan"  id="1" lower="-3.14" upper="3.14"/>
        <xacro:sts_position_joint name="right_arm_shoulder_lift" id="2" lower="-1.75" upper="1.75"/>
        <xacro:sts_position_joint name="right_arm_elbow_flex"    id="3" lower="-1.75" upper="1.75"/>
        <xacro:sts_position_joint name="right_arm_wrist_flex"    id="4" lower="-1.75" upper="1.75"/>
        <xacro:sts_position_joint name="right_arm_wrist_roll"    id="5" lower="-3.14" upper="3.14"/>
        <xacro:sts_position_joint name="right_arm_gripper"       id="6" lower="0.0"   upper="1.75"/>
      </xacro:if>

      <!-- The RIGHT motor is mounted mirrored (confirmed on the real robot by
           commanding each wheel individually and watching it turn - see
           controllers.yaml's right_wheel_radius_multiplier comment; an
           earlier version of this comment guessed it was the left motor,
           that guess was wrong).

           Checked the driver source: it has no per-joint invert param. What it
           does have is a FIXED, uniform CW-to-REP103-CCW inversion applied the
           same way to every joint (sts_conversions.hpp), which is a different
           problem (protocol convention) to ours (this robot's mechanical
           mounting). It doesn't help here.

           NOT in this file: don't add a fake invert param, it will be
           silently ignored (joint.parameters.count() just won't find it, no
           error). The actual fix is diff_drive_controller's
           right_wheel_radius_multiplier: -1.0, see controllers.yaml - that's
           the "sign goes in the ros2_control joint config, once" ARCHITECTURE.md
           section 1.2 talks about, just one layer up from here since the
           hardware interface itself can't do it. -->
      <joint name="left_wheel_joint">
        <param name="motor_id">9</param>
        <param name="operating_mode">1</param>
        <command_interface name="velocity">
          <param name="min">${-wmax}</param>
          <param name="max">${wmax}</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
        <state_interface name="temperature"/>
        <state_interface name="current"/>
        <state_interface name="voltage"/>
      </joint>

      <joint name="right_wheel_joint">
        <param name="motor_id">10</param>
        <param name="operating_mode">1</param>
        <command_interface name="velocity">
          <param name="min">${-wmax}</param>
          <param name="max">${wmax}</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
        <state_interface name="temperature"/>
        <state_interface name="current"/>
        <state_interface name="voltage"/>
      </joint>
    </ros2_control>

  </xacro:macro>
</robot>
