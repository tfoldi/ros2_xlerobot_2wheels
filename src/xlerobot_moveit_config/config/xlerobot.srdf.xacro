<?xml version="1.0"?>
<!--
  Semantic description for MoveIt, the groups and named states of the two arms and the head.

  Joint values in the named states are the model's joint angles (see arms.joints in
  robot_dimensions.yaml): `rest` is arms.rest_pose, the folded pose the arms rest in.
  The self-collision matrix is generated by tools/generate_moveit_collisions.py into
  disabled_collisions.xacro, regenerate it after the geometry or the joint limits change.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="xlerobot">
  <!-- false leaves the self-collision matrix out, for tools/generate_moveit_collisions.py -->
  <xacro:arg name="disabled_collisions" default="true"/>
  <xacro:property name="dims" value="${xacro.load_yaml('$(find xlerobot_description)/config/robot_dimensions.yaml')['xlerobot']}"/>
  <xacro:property name="rest" value="${dims['arms']['rest_pose']}"/>

  <group name="left_arm">
    <chain base_link="left_arm_base_link" tip_link="left_arm_gripper_link"/>
  </group>
  <group name="left_gripper">
    <joint name="left_arm_gripper_joint"/>
  </group>
  <group name="right_arm">
    <chain base_link="right_arm_base_link" tip_link="right_arm_gripper_link"/>
  </group>
  <group name="right_gripper">
    <joint name="right_arm_gripper_joint"/>
  </group>
  <group name="both_arms">
    <group name="left_arm"/>
    <group name="right_arm"/>
  </group>
  <group name="head">
    <joint name="head_pan_joint"/>
    <joint name="head_tilt_joint"/>
  </group>

  <end_effector name="left_hand" parent_link="left_arm_gripper_link" group="left_gripper" parent_group="left_arm"/>
  <end_effector name="right_hand" parent_link="right_arm_gripper_link" group="right_gripper" parent_group="right_arm"/>

  <group_state name="rest" group="left_arm">
    <joint name="left_arm_shoulder_pan_joint" value="${rest['shoulder_pan']}"/>
    <joint name="left_arm_shoulder_lift_joint" value="${rest['shoulder_lift']}"/>
    <joint name="left_arm_elbow_flex_joint" value="${rest['elbow_flex']}"/>
    <joint name="left_arm_wrist_flex_joint" value="${rest['wrist_flex']}"/>
    <joint name="left_arm_wrist_roll_joint" value="${rest['wrist_roll']}"/>
  </group_state>
  <group_state name="zero" group="left_arm">
    <joint name="left_arm_shoulder_pan_joint" value="0"/>
    <joint name="left_arm_shoulder_lift_joint" value="0"/>
    <joint name="left_arm_elbow_flex_joint" value="0"/>
    <joint name="left_arm_wrist_flex_joint" value="0"/>
    <joint name="left_arm_wrist_roll_joint" value="0"/>
  </group_state>
  <group_state name="closed" group="left_gripper">
    <joint name="left_arm_gripper_joint" value="${rest['gripper']}"/>
  </group_state>
  <group_state name="open" group="left_gripper">
    <joint name="left_arm_gripper_joint" value="-0.7"/>
  </group_state>
  <group_state name="rest" group="right_arm">
    <joint name="right_arm_shoulder_pan_joint" value="${rest['shoulder_pan']}"/>
    <joint name="right_arm_shoulder_lift_joint" value="${rest['shoulder_lift']}"/>
    <joint name="right_arm_elbow_flex_joint" value="${rest['elbow_flex']}"/>
    <joint name="right_arm_wrist_flex_joint" value="${rest['wrist_flex']}"/>
    <joint name="right_arm_wrist_roll_joint" value="${rest['wrist_roll']}"/>
  </group_state>
  <group_state name="zero" group="right_arm">
    <joint name="right_arm_shoulder_pan_joint" value="0"/>
    <joint name="right_arm_shoulder_lift_joint" value="0"/>
    <joint name="right_arm_elbow_flex_joint" value="0"/>
    <joint name="right_arm_wrist_flex_joint" value="0"/>
    <joint name="right_arm_wrist_roll_joint" value="0"/>
  </group_state>
  <group_state name="closed" group="right_gripper">
    <joint name="right_arm_gripper_joint" value="${rest['gripper']}"/>
  </group_state>
  <group_state name="open" group="right_gripper">
    <joint name="right_arm_gripper_joint" value="-0.7"/>
  </group_state>
  <group_state name="rest" group="both_arms">
    <joint name="left_arm_shoulder_pan_joint" value="${rest['shoulder_pan']}"/>
    <joint name="left_arm_shoulder_lift_joint" value="${rest['shoulder_lift']}"/>
    <joint name="left_arm_elbow_flex_joint" value="${rest['elbow_flex']}"/>
    <joint name="left_arm_wrist_flex_joint" value="${rest['wrist_flex']}"/>
    <joint name="left_arm_wrist_roll_joint" value="${rest['wrist_roll']}"/>
    <joint name="right_arm_shoulder_pan_joint" value="${rest['shoulder_pan']}"/>
    <joint name="right_arm_shoulder_lift_joint" value="${rest['shoulder_lift']}"/>
    <joint name="right_arm_elbow_flex_joint" value="${rest['elbow_flex']}"/>
    <joint name="right_arm_wrist_flex_joint" value="${rest['wrist_flex']}"/>
    <joint name="right_arm_wrist_roll_joint" value="${rest['wrist_roll']}"/>
  </group_state>
  <group_state name="forward" group="head">
    <joint name="head_pan_joint" value="0"/>
    <joint name="head_tilt_joint" value="0"/>
  </group_state>

  <xacro:if value="$(arg disabled_collisions)">
    <xacro:include filename="$(find xlerobot_moveit_config)/config/disabled_collisions.xacro"/>
  </xacro:if>
</robot>
