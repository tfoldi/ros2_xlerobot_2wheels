Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
    - Class: moveit_rviz_plugin/MotionPlanning
      Name: MotionPlanning
      Enabled: true
      Planning Request:
        Planning Group: left_arm
      Scene Robot:
        Robot Alpha: 0.5
        Show Scene Robot: true
  Global Options:
    Fixed Frame: base_footprint
    Frame Rate: 30
  Name: root
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 3.0
      Focal Point:
        X: 0
        Y: 0
        Z: 0.9
      Name: Current View
      Pitch: 0.4
      Yaw: 3.0
