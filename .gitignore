# colcon workspace build artifacts
build/
install/
log/

# vcs-imported community deps, pulled fresh from xlerobot.repos, not tracked here.
# Names have to match xlerobot.repos, add a line here for anything new in it.
/src/sts_hardware_interface/
/src/so_arm_ros2/
/src/topic_based_hardware_interfaces/
/src/ldrobot_lidar_ros2/

__pycache__/
*.pyc

.vscode/
*.swp

# Isaac Sim twin: generated, regenerate with sim/build_isaac_scene.py
# (which itself regenerates xlerobot_import.urdf from the xacro first,
# see docs/sim-twin.md). Not source, don't commit either.
/sim/xlerobot_import.urdf
/sim/output/

# rosbag recordings, bringup.launch.py record:=true
/bags/

# recorded arm trajectories, tools/record_trajectory.py - not curated like saved_positions.yaml
/trajectories/

# camera frames, tools/capture_image.py - ephemeral, not curated
/captures/

# machine-specific MCP server registration (absolute paths to a per-user venv) - see
# tools/mcp_server/README.md for the .mcp.json snippet to create your own
/.mcp.json

# MCP tool-call audit log, tools/mcp_server/call_log.py - runtime artifact, not curated
/logs/

# slam_toolbox pose graphs, several MB each, kept on the robot
/src/xlerobot_navigation/maps/*.posegraph
/src/xlerobot_navigation/maps/*.data
